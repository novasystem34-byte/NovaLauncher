<Window x:Class="NovaLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:NovaLauncher.Core"
        Title="Nova System Launcher"
        Icon="AppIcon.ico"
        Height="680" Width="1000"
        MinHeight="500" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource BrushBackgroundDarkest}"
        Closing="OnWindowClosing"
        StateChanged="OnWindowStateChanged">

    <Window.Resources>
        <core:FilePathToImageSourceConverter x:Key="IconConverter"/>

        <Style x:Key="GameCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushBackgroundPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Width" Value="210"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushCardHoverGradient}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Top header bar -->
        <Border DockPanel.Dock="Top" Padding="26,20">
            <Border.Background>
                <SolidColorBrush Color="#161B22"/>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="6" CornerRadius="3" Background="{StaticResource BrushHeaderGradient}" Margin="0,0,12,0"/>
                        <TextBlock FontSize="24" FontWeight="Bold">
                            <Run Text="NOVA" Foreground="{StaticResource BrushAccent}"/>
                            <Run Text=" SYSTEM LAUNCHER"/>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="مكتبتك الخاصة - خفيف على النظام، ويفسح كل الموارد للعبة أثناء التشغيل"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="18,4,0,0" FontSize="12"/>
                </StackPanel>

                <Button Grid.Column="1" Content="➕  إضافة لعبة جديدة" Style="{StaticResource NovaAccentButton}"
                        Click="OnAddGameClick" VerticalAlignment="Center" FontSize="13.5" Padding="18,10"/>
            </Grid>
        </Border>

        <!-- Toolbar: search, sort, stats -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BrushBackgroundDarkest}" Padding="26,14,26,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" MaxWidth="320" HorizontalAlignment="Left">
                    <TextBox x:Name="SearchTextBox"
                             Padding="10,8" Background="{StaticResource BrushBackgroundPanel}"
                             Foreground="{StaticResource BrushTextPrimary}" BorderBrush="{StaticResource BrushBorder}"
                             TextChanged="OnSearchTextChanged"/>
                    <TextBlock x:Name="SearchPlaceholderText" Text="🔍  ابحث عن لعبة..."
                               Foreground="{StaticResource BrushTextSecondary}"
                               Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>

                <ComboBox x:Name="SortComboBox" Grid.Column="1" Width="170" Margin="14,0,0,0"
                          SelectionChanged="OnSortChanged" SelectedIndex="0">
                    <ComboBoxItem Content="الأحدث لعباً"/>
                    <ComboBoxItem Content="الأكثر وقت لعب"/>
                    <ComboBoxItem Content="الاسم (أبجدي)"/>
                    <ComboBoxItem Content="الأحدث إضافة"/>
                </ComboBox>

                <TextBlock x:Name="LibraryStatsText" Grid.Column="2" Margin="20,0,0,0"
                           Foreground="{StaticResource BrushTextSecondary}" FontSize="12"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BrushBackgroundPanel}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="22,10">
            <TextBlock x:Name="StatusBarText" Foreground="{StaticResource BrushTextSecondary}" FontSize="12"/>
        </Border>

        <!-- Library grid -->
        <Grid Margin="26,22,26,10">
            <TextBlock x:Name="EmptyLibraryHint"
                       Text="مكتبتك فارغة حالياً. اضغط &quot;إضافة لعبة جديدة&quot; لاختيار أول لعبة من جهازك."
                       Foreground="{StaticResource BrushTextSecondary}" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="GamesItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GameCardStyle}">
                                <StackPanel Margin="16">
                                    <Grid HorizontalAlignment="Center" Margin="0,4,0,12">
                                        <Border Width="72" Height="72" CornerRadius="14"
                                                Background="{StaticResource BrushBackgroundElevated}"/>
                                        <Image Source="{Binding IconCachePath, Converter={StaticResource IconConverter}}"
                                               Width="48" Height="48"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Border Width="14" Height="14" CornerRadius="7"
                                                Background="{StaticResource BrushAccent}"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,-2,-2,0"
                                                Visibility="{Binding IsRunningVisibility}"
                                                ToolTip="قيد التشغيل الآن"/>
                                        <Button Content="{Binding FavoriteGlyph}" Tag="{Binding}"
                                                Click="OnToggleFavoriteClick"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Margin="-4,-4,0,0" Width="24" Height="24" Padding="0"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{StaticResource BrushWarning}" FontSize="15"
                                                Cursor="Hand" ToolTip="إضافة للمفضلة"/>
                                    </Grid>

                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14.5"
                                               TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               MaxHeight="40" Margin="0,0,0,6"/>

                                    <TextBlock Text="{Binding DisplayPlaytime, Mode=OneWay}"
                                               Foreground="{StaticResource BrushTextSecondary}" FontSize="11.5"
                                               TextAlignment="Center" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding DisplayLastPlayed, Mode=OneWay}"
                                               Foreground="{StaticResource BrushTextSecondary}" FontSize="10.5"
                                               TextAlignment="Center" Margin="0,0,0,14"/>

                                    <Button Content="▶  تشغيل" Style="{StaticResource NovaAccentButton}"
                                            Click="OnPlayGameClick" Tag="{Binding}" HorizontalAlignment="Stretch"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                        <Button Content="✏" Style="{StaticResource NovaButton}" Padding="10,4"
                                                ToolTip="إعادة تسمية" Click="OnRenameGameClick" Tag="{Binding}" Margin="0,0,6,0"/>
                                        <Button Content="⚙" Style="{StaticResource NovaButton}" Padding="10,4"
                                                ToolTip="خيارات تشغيل إضافية (Launch Arguments)" Click="OnEditLaunchArgumentsClick" Tag="{Binding}" Margin="0,0,6,0"/>
                                        <Button Content="📂" Style="{StaticResource NovaButton}" Padding="10,4"
                                                ToolTip="فتح مجلد اللعبة" Click="OnOpenFolderClick" Tag="{Binding}" Margin="0,0,6,0"/>
                                        <Button Content="🗑" Style="{StaticResource NovaDangerButton}" Padding="10,4"
                                                ToolTip="إزالة من المكتبة" Click="OnRemoveGameClick" Tag="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

    </DockPanel>
</Window>

