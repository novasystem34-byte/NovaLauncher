<Application x:Class="NovaLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <SolidColorBrush x:Key="BrushBackgroundDarkest" Color="#0D1117"/>
            <SolidColorBrush x:Key="BrushBackgroundPanel" Color="#161B22"/>
            <SolidColorBrush x:Key="BrushBackgroundElevated" Color="#1F2530"/>
            <SolidColorBrush x:Key="BrushBorder" Color="#2B3240"/>
            <SolidColorBrush x:Key="BrushAccent" Color="#3DDC97"/>
            <SolidColorBrush x:Key="BrushDanger" Color="#E5484D"/>
            <SolidColorBrush x:Key="BrushWarning" Color="#F2B84B"/>
            <SolidColorBrush x:Key="BrushTextPrimary" Color="#E6EDF3"/>
            <SolidColorBrush x:Key="BrushTextSecondary" Color="#8B949E"/>

            <LinearGradientBrush x:Key="BrushHeaderGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#3DDC97" Offset="0"/>
                <GradientStop Color="#2FB4E0" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="BrushCardHoverGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1F2530" Offset="0"/>
                <GradientStop Color="#171C25" Offset="1"/>
            </LinearGradientBrush>

            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource BrushBackgroundDarkest}"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            </Style>

            <Style x:Key="NovaButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrushBackgroundElevated}"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NovaAccentButton" TargetType="Button" BasedOn="{StaticResource NovaButton}">
                <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
                <Setter Property="Foreground" Value="#0D1117"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
            </Style>

            <Style x:Key="NovaDangerButton" TargetType="Button" BasedOn="{StaticResource NovaButton}">
                <Setter Property="Background" Value="{StaticResource BrushDanger}"/>
                <Setter Property="Foreground" Value="#0D1117"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}"/>
            </Style>

            <Style TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Margin="0,4">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBackgroundElevated}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1B2230"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="{StaticResource BrushBackgroundPanel}"/>
                <Setter Property="Width" Value="10"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
